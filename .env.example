# Flask API configuration
APP_ENV=development
PORT=8000
# For local development, leave DATABASE_URL unset to use SQLite.
# For PostgreSQL, use a connection URL from your hosting provider. Never commit
# real database credentials here; keep them in your local .env or host secrets.
DATABASE_URL=
UPLOAD_DIR=backend/uploads
MAX_CONTENT_LENGTH=10485760
MAX_IMAGE_PIXELS=25000000
MODEL_ID=nlpconnect/vit-gpt2-image-captioning
# Set this to the public Streamlit app origin on the deployed backend.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit frontend setting. For local development this defaults to
# http://127.0.0.1:8000; set BACKEND_URL to the deployed Flask API in Streamlit
# Community Cloud secrets.
BACKEND_URL=http://127.0.0.1:8000